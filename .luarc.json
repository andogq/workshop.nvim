{
    "runtime.version": "LuaJIT",
    "runtime.path": [
        "lua/?.lua",
        "lua/?/init.lua"
    ],
    "diagnostics.globals": [
        "vim",
        "describe",
        "it",
        "before_each",
        "after_each",
        "setup",
        "teardown",
        "pending"
    ],
    "workspace.checkThirdParty": false,
    "workspace.ignoreDir": [
        ".tests",
        ".git"
    ],
    "telemetry.enable": false
}
